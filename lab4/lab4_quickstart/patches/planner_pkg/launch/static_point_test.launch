<launch>
  
  
  <arg name="simulator_data_directory" default="$(env HOME)/vnav-builds/vnav-2021-lab4/vnav-2021-lab4_Data" />

  
  <node name="controller_node" pkg="controller_pkg" type="controller_node" />

  
  <node name="traj_vertices_publisher" pkg="planner_pkg" type="traj_vertices_publisher" output="screen">

    
    <param name="simulator_data_directory" value="$(arg simulator_data_directory)" />
  </node>

  
  
  <node name="simple_traj_planner" pkg="planner_pkg" type="simple_traj_planner" />

<arg name="kx" default="2.0" /><param name="kx" value="$(arg kx)" /><arg name="kv" default="3.0" /><param name="kv" value="$(arg kv)" /><arg name="kr" default="3.0" /><param name="kr" value="$(arg kr)" /><arg name="komega" default="1.0" /><param name="komega" value="$(arg komega)" /></launch>
